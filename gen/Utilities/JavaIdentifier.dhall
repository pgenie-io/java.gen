let Deps = ../Deps/package.dhall

let javaKeywords
    : List Text
    = [ "abstract"
      , "assert"
      , "boolean"
      , "break"
      , "byte"
      , "case"
      , "catch"
      , "char"
      , "class"
      , "const"
      , "continue"
      , "default"
      , "do"
      , "double"
      , "else"
      , "enum"
      , "extends"
      , "final"
      , "finally"
      , "float"
      , "for"
      , "goto"
      , "if"
      , "implements"
      , "import"
      , "instanceof"
      , "int"
      , "interface"
      , "long"
      , "module"
      , "native"
      , "new"
      , "package"
      , "private"
      , "protected"
      , "public"
      , "record"
      , "return"
      , "sealed"
      , "short"
      , "static"
      , "strictfp"
      , "super"
      , "switch"
      , "synchronized"
      , "this"
      , "throw"
      , "throws"
      , "transient"
      , "try"
      , "void"
      , "volatile"
      , "while"
      , "exports"
      , "open"
      , "requires"
      , "transitive"
      , "uses"
      , "provides"
      , "with"
      , "var"
      , "yield"
      , "true"
      , "false"
      , "null"
      ]

in  { escape =
        \(rendered : Text) ->
          if    Deps.Prelude.List.any
                  Text
                  (\(kw : Text) -> Text/equal kw rendered)
                  javaKeywords
          then  "${rendered}_"
          else  rendered
    }
